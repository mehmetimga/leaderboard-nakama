# Server Configuration
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# Nakama Configuration
NAKAMA_HOST=localhost
NAKAMA_HTTP_PORT=7350
NAKAMA_GRPC_PORT=7349
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_USE_SSL=false

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=localdb
POSTGRES_DB=nakama
POSTGRES_SSLMODE=disable

# Worker Configuration
WORKER_ENABLED=true
WORKER_SNAPSHOT_INTERVAL=30m

# Leaderboards to snapshot (comma-separated)
SNAPSHOT_LEADERBOARDS=global_scores,weekly_scores

